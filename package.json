{
  "name": "sixth-front",
  "version": "1.16.0",
  "private": true,
  "description": "Battlefield-style browser shooter built with three.js",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "build:web": "node android/prepare-web.mjs",
    "build:apk": "bash android/build-apk.sh",
    "build:exe": "bash windows/build-exe.sh",
    "release": "bash release.sh"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "three": "0.169.0"
  }
}
