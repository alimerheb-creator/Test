  "script": [
    "// Paint the ground, bushes and trees in desert colours (only once per page: this map restarts the game)",
    "const w = api.game.world;",
    "const sand = new THREE.Color('#d8b886'), dune = new THREE.Color('#c9a26f');",
    "const col = w.terrain.geometry.attributes.color;",
    "const base = (w.terrain.userData.baseColors ||= col.array.slice());",
    "const c = new THREE.Color();",
    "for (let i = 0; i < base.length; i += 3) {",
    "  const lum = 0.3 * base[i] + 0.59 * base[i + 1] + 0.11 * base[i + 2];",
    "  const k = Math.max(0.55, Math.min(1.5, lum / 0.17));",
    "  c.copy(sand).lerp(dune, Math.random() * 0.25).multiplyScalar(k);",
    "  col.array[i] = base[i] * 0.15 + c.r * 0.85;",
    "  col.array[i + 1] = base[i + 1] * 0.15 + c.g * 0.85;",
    "  col.array[i + 2] = base[i + 2] * 0.15 + c.b * 0.85;",
    "}",
    "col.needsUpdate = true;",
    "const dry = new THREE.Color('#8f7a4e');",
    "for (const m of [w.bushMesh, w.pineMesh, w.leafMesh]) {",
    "  if (!m || !m.instanceColor) continue;",
    "  const a = m.instanceColor.array;",
    "  const b0 = (m.userData.baseColors ||= a.slice());",
    "  for (let i = 0; i < a.length; i += 3) { a[i] = b0[i] * 0.3 + dry.r * 0.7; a[i + 1] = b0[i + 1] * 0.3 + dry.g * 0.7; a[i + 2] = b0[i + 2] * 0.3 + dry.b * 0.7; }",
    "  m.instanceColor.needsUpdate = true;",
    "}"
  ]
}
