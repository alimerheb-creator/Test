{
  "format": "sixthfront-mod",
  "id": "mode-gun-game",
  "name": "Mode: Gun Game",
  "version": "1.0",
  "author": "Sixth Front",
  "description": "Every kill with your current gun moves you up to the next one: PDW, carbine, SCAR-H, pump shotgun, LMG, DMR, sniper, magnum revolver, pistol. The first soldier to get a kill with the pistol wins for their team. A knife kill steals a level. No gadgets, no grenades, no tanks, no flags. The game restarts when you switch it on or off.",
  "map": {
    "flags": []
  },
  "rules": {
    "startTickets": 5000,
    "respawnTime": 2,
    "downedTime": 5,
    "spawnProtection": 2
  },
  "vehicles": {
    "tank": {
      "perTeam": 0
    }
  },
  "weapons": {
    "gg_scar": {
      "base": "ar",
      "name": "SCAR-H",
      "rpm": 600,
      "dmg": [34, 26],
      "range": [30, 90],
      "mag": 20,
      "reserve": 100,
      "reload": 2.4,
      "reloadEmpty": 3.1,
      "recoil": [0.017, 0.007],
      "sound": "heavy",
      "botRange": 130,
      "tracer": "#ff7a45"
    },
    "gg_pump": {
      "base": "smg",
      "name": "M870 PUMP",
      "kind": "bolt",
      "rpm": 70,
      "pellets": 9,
      "dmg": [17, 3],
      "range": [8, 32],
      "mag": 6,
      "reserve": 36,
      "reloadType": "shell",
      "shellTime": 0.5,
      "spreadHip": 0.07,
      "spreadAds": 0.05,
      "bloom": 0,
      "bloomMax": 0,
      "recoil": [0.06, 0.012],
      "adsFov": 58,
      "head": 1.4,
      "sound": "shotgun",
      "model": "shotgun",
      "botRange": 32
    },
    "gg_dmr": {
      "base": "ar",
      "name": "MK-11 DMR",
      "kind": "semi",
      "rpm": 240,
      "dmg": [48, 38],
      "range": [40, 150],
      "mag": 12,
      "reserve": 72,
      "spreadAds": 0.001,
      "recoil": [0.03, 0.006],
      "adsFov": 30,
      "sound": "heavy",
      "botRange": 160
    },
    "gg_magnum": {
      "base": "pistol",
      "name": "R-44 MAGNUM",
      "rpm": 150,
      "dmg": [70, 45],
      "range": [15, 45],
      "mag": 6,
      "reserve": 36,
      "reloadType": "shell",
      "shellTime": 0.35,
      "recoil": [0.05, 0.01],
      "sound": "heavy",
      "botRange": 50
    }
  },
  "gadgets": {
    "gg_none": {
      "base": "c4",
      "name": "NO GADGET",
      "ammo": 0
    }
  },
  "script": [
    "const LADDER = ['smg', 'ar', 'gg_scar', 'gg_pump', 'lmg', 'gg_dmr', 'sniper', 'gg_magnum', 'pistol'];",
    "const W = api.config.WEAPONS;",
    "const level = new Map();",
    "let over = false;",
    "const lv = (s) => level.get(s) || 0;",
    "const gunOf = (s) => W[LADDER[Math.min(lv(s), LADDER.length - 1)]];",
    "",
    "// Everyone carries only their current gun",
    "function arm(s) {",
    "  if (s.state !== 'alive') return;",
    "  const id = LADDER[Math.min(lv(s), LADDER.length - 1)];",
    "  s.slot = 0;",
    "  api.giveWeapon(s, 0, id);",
    "  api.giveWeapon(s, 1, id);",
    "  api.setGadget(s, 'gg_none');",
    "  s.grenades = 0;",
    "}",
    "api.on('matchStart', () => {",
    "  level.clear(); over = false;",
    "  const eb = document.getElementById('mm-eyebrow');",
    "  if (eb) eb.textContent = 'GUN GAME  ·  ' + api.config.MAP.name + '  ·  9 GUNS';",
    "});",
    "api.on('spawn', (s) => arm(s));",
    "api.on('revive', (e) => arm(e.soldier));",
    "",
    "api.on('kill', (e) => {",
    "  const k = e.killer, v = e.victim;",
    "  if (over || !k || k === v || k.team === v.team) return;",
    "  const knife = e.weapon === 'COMBAT KNIFE';",
    "  if (!knife && e.weapon !== gunOf(k).name) return; // only kills with your current gun count",
    "  if (knife && lv(v) > 0) {",
    "    level.set(v, lv(v) - 1);",
    "    if (v.isPlayer) api.banner('KNIFED! YOU LOST A LEVEL', '#ff4b3a');",
    "  }",
    "  if (lv(k) >= LADDER.length - 1) {",
    "    over = true;",
    "    const mine = k.team === api.player().team;",
    "    api.banner(`${k.name.toUpperCase()} WINS THE GUN GAME`, mine ? '#3fa9f5' : '#ff4b3a');",
    "    api.after(1, () => api.endMatch(k.team));",
    "    return;",
    "  }",
    "  level.set(k, lv(k) + 1);",
    "  api.award(k, 50, 'LEVEL UP');",
    "  api.after(0, () => arm(k)); // swap guns after this shot has finished",
    "  if (k.isPlayer) {",
    "    api.banner(`LEVEL ${lv(k) + 1}: ${gunOf(k).name}`, '#f2b33d');",
    "    api.tone(880, 0.12, 'triangle', 0.15);",
    "  }",
    "});",
    "",
    "api.every(0.3, () => {",
    "  if (api.state() !== 'playing') { api.hud.remove('gg'); api.hud.remove('lead'); return; }",
    "  const P = api.player();",
    "  const l = lv(P);",
    "  const next = l + 1 < LADDER.length ? W[LADDER[l + 1]].name : 'VICTORY';",
    "  api.hud.text('gg', `GUN GAME  ·  LEVEL ${l + 1}/${LADDER.length}  ·  NEXT: ${next}`, { x: 50, y: 17, size: 0.7, color: '#f2b33d' });",
    "  let best = P;",
    "  for (const s of api.soldiers()) if (lv(s) > lv(best)) best = s;",
    "  api.hud.text('lead', `LEADER: ${best.name.toUpperCase()}  ·  LEVEL ${lv(best) + 1}`, { x: 50, y: 21, size: 0.6, color: best.team === P.team ? '#3fa9f5' : '#ff4b3a' });",
    "});"
  ]
}
