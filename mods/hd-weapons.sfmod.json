  "script": [
    "// Weapon models are in the \"weapons\" section above. This script adds the rest:",
    "// reflections on your gun, brass that flies out and stays on the ground, and barrel smoke after a long burst.",
    "const g = api.game, pc = g.playerCtl, fx = g.effects;",
    "const rnd = (a, b) => a + Math.random() * (b - a);",
    "const onOff = (fn) => {",
    "  if (api.onDisable) return api.onDisable(fn);",
    "  // Older game versions: a hidden model's remove() runs when the mod is switched off",
    "  const h = api.addModel([{ shape: 'box', size: [0.01, 0.01, 0.01] }], { x: 0, y: -500, z: 0 });",
    "  h.setVisible(false);",
    "  const remove = h.remove;",
    "  h.remove = () => { remove(); fn(); };",
    "};",
    "",
    "// The gun in your hands reflects the sky, like everything else in the world",
    "const vm = pc.vmScene;",
    "const before = { env: vm.environment, intensity: vm.environmentIntensity };",
    "onOff(() => { vm.environment = before.env; vm.environmentIntensity = before.intensity ?? 1; });",
    "",
    "// Spent brass",
    "const v1 = api.vec(), v2 = api.vec();",
    "function eject(s, def) {",
    "  if (s.state !== 'alive' || s.vehicle) return;",
    "  const cam = g.camera.position;",
    "  if (s.pos.distanceToSquared(cam) > 30 * 30) return;",
    "  const shell = (def.pellets || 1) > 1;",
    "  const size = shell ? 1.5 : def.model === 'pistol' ? 0.75 : def.model === 'smg' ? 0.85 : def.model === 'sniper' ? 1.35 : def.model === 'lmg' ? 1.1 : 1;",
    "  const e = s.eye(v1), f = s.forward(v2);",
    "  const rx = Math.cos(s.yaw), rz = -Math.sin(s.yaw);",
    "  const reach = s.isPlayer ? 0.35 : 0.55, side = s.isPlayer ? 0.1 : 0.08;",
    "  if (fx.debrisList.length >= fx.debrisMax) fx.debrisList.shift();",
    "  fx.debrisList.push({",
    "    x: e.x + f.x * reach + rx * side, y: e.y + f.y * reach - (s.isPlayer ? 0.1 : 0.2), z: e.z + f.z * reach + rz * side,",
    "    vx: s.vel.x + rx * rnd(1.8, 3.2) - f.x * rnd(0, 0.8), vy: rnd(1.4, 2.8), vz: s.vel.z + rz * rnd(1.8, 3.2) - f.z * rnd(0, 0.8),",
    "    rx: rnd(0, 6), ry: rnd(0, 6), rz: 0, wx: rnd(-25, 25), wy: rnd(-25, 25),",
    "    sx: 0.011 * size, sy: 0.011 * size, sz: (shell ? 0.05 : 0.03) * size, life: 8, color: shell ? 0xa3261e : 0xc9a14a, rest: false,",
    "  });",
    "}",
    "let heat = 0;",
    "api.on('fire', (e) => {",
    "  const s = e.soldier, def = e.weapon;",
    "  if (def.id === 'coax') return;",
    "  // bolt-action rifles and pump guns throw the case out when the action is worked",
    "  if (def.kind === 'bolt') api.after(def.reloadType === 'shell' ? 0.2 : 0.35, () => eject(s, def));",
    "  else eject(s, def);",
    "  if (s.isPlayer) heat = Math.min(1.2, heat + (def.kind === 'auto' ? 0.05 : 0.2));",
    "});",
    "",
    "api.on('tick', (dt) => {",
    "  // keep the viewmodel's reflections in step with the sky (mods can change the time of day)",
    "  vm.environment = g.scene.environment;",
    "  vm.environmentIntensity = (g.scene.environmentIntensity ?? 0.55) * 1.15;",
    "  // a wisp of smoke curls off a hot barrel once you stop shooting",
    "  heat = Math.max(0, heat - dt * 0.3);",
    "  const P = api.player();",
    "  if (heat > 0.35 && P && P.state === 'alive' && !P.vehicle && P.slot < 2 && g.time - P.lastFireT > 0.2 && Math.random() < heat * 0.45) {",
    "    const m = pc._muzzleWorld(api.vec());",
    "    fx.smoke.add(m.x, m.y, m.z, rnd(-0.08, 0.08), rnd(0.25, 0.5), rnd(-0.08, 0.08), rnd(0.9, 1.5), 0.025, 0.16, 0xd8d4cc, 0.22, -0.35, 1.2);",
    "  }",
    "});"
  ]
}
