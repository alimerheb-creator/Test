  "script": [
    "const SPOTS = [{\"name\":\"MARKET\",\"x\":0,\"z\":0},{\"name\":\"QUARRY\",\"x\":-135,\"z\":110},{\"name\":\"CEMENT WORKS\",\"x\":135,\"z\":-105},{\"name\":\"OLD MILL\",\"x\":120,\"z\":95},{\"name\":\"RELAY STATION\",\"x\":-120,\"z\":-100}];",
    "const PERIOD = 60;",
    "let idx = 0, next = 0;",
    "function place(i, announce) {",
    "  const f = api.flags()[0];",
    "  if (!f) return;",
    "  const s = SPOTS[i];",
    "  f.x = s.x; f.z = s.z; f.y = api.heightAt(s.x, s.z); f.name = s.name;",
    "  f.owner = -1; f.progress = 0; f.contested = false; f.capturing = -1;",
    "  if (f.cloth && f.cloth.parent) f.cloth.parent.position.set(f.x, f.y, f.z);",
    "  for (const b of api.soldiers()) if (b.brain) { b.brain.moveTarget = null; b.brain.thinkT = 0; }",
    "  if (announce) {",
    "    api.banner(`HARDPOINT MOVED: ${s.name}`, '#f2b33d');",
    "    api.sound('capture');",
    "  }",
    "}",
    "api.on('matchStart', () => {",
    "  idx = 0; next = api.time() + PERIOD; place(0, false);",
    "  const eb = document.getElementById('mm-eyebrow');",
    "  if (eb) eb.textContent = 'HARDPOINT  ·  ' + api.config.MAP.name + '  ·  MOVES EVERY 60s';",
    "});",
    "api.on('tick', () => {",
    "  if (api.time() < next) return;",
    "  idx = (idx + 1) % SPOTS.length;",
    "  next = api.time() + PERIOD;",
    "  place(idx, true);",
    "});",
    "api.every(0.5, () => {",
    "  if (api.state() !== 'playing') { api.hud.remove('hp'); return; }",
    "  const left = Math.max(0, Math.ceil(next - api.time()));",
    "  api.hud.text('hp', `HARDPOINT: ${SPOTS[idx].name}  ·  MOVES IN ${left}s`, { x: 50, y: 17, size: 0.7, color: left <= 10 ? '#ff4b3a' : '#f2b33d' });",
    "});"
  ]
}
